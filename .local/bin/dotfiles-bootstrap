#!/usr/bin/env bash
set -euo pipefail

# dotfiles-bootstrap — install all the nice tools on a fresh machine

TOOLS=(eza bat dust btop htop fd ripgrep fzf zoxide tlrc starship jq yq git-delta lazygit)
ZSH_PLUGINS=(zsh-autosuggestions zsh-syntax-highlighting)

# Tools that aren't available or don't make sense on Windows
SKIP_ON_WINDOWS=(btop htop)

# Brew name → Scoop name (only where they differ)
# Declared inside install_tools_scoop to avoid bash 3.x issues on macOS

info() { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m==> %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m==> %s\033[0m\n' "$*" >&2; }

is_gitbash() {
    [[ "${MSYSTEM:-}" =~ ^(MINGW|MSYS|CLANGARM) ]] || [[ "$(uname -s)" =~ ^(MINGW|MSYS) ]]
}

# --- Linux prereq check ---
# Linuxbrew needs a working build toolchain. On bare RHEL/Debian boxes these
# aren't installed by default; warn loudly rather than fail deep in a brew build.
check_linux_prereqs() {
    [[ "$(uname -s)" != "Linux" ]] && return 0

    local missing=()
    for cmd in git curl file gcc make; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done

    [[ ${#missing[@]} -eq 0 ]] && return 0

    warn "Missing build prerequisites: ${missing[*]}"
    if   [[ -r /etc/redhat-release ]] || command -v dnf >/dev/null 2>&1; then
        err "Install with: sudo dnf groupinstall -y 'Development Tools' && sudo dnf install -y curl file git"
    elif command -v apt >/dev/null 2>&1; then
        err "Install with: sudo apt update && sudo apt install -y build-essential curl file git"
    elif command -v zypper >/dev/null 2>&1; then
        err "Install with: sudo zypper install -y -t pattern devel_basis && sudo zypper install -y curl file git"
    else
        err "Install a build toolchain (gcc, make), plus curl, file, git, before continuing."
    fi
    exit 1
}

# --- Scoop (git-bash / Windows) ---

ensure_scoop() {
    if ! command -v scoop >/dev/null 2>&1; then
        info "Installing Scoop..."
        powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force; irm get.scoop.sh | iex"
        # Reload PATH so scoop is visible in this session
        export PATH="$USERPROFILE/scoop/shims:$PATH"
    else
        info "Scoop already installed"
    fi

    # extras bucket is needed for lazygit (and others)
    if ! scoop bucket list 2>/dev/null | grep -q extras; then
        info "Adding Scoop extras bucket..."
        scoop bucket add extras
    fi
}

install_tools_scoop() {
    declare -A SCOOP_NAME=(
        [git-delta]=delta
    )
    info "Installing tools via Scoop..."
    local to_install=() skipped=()
    for tool in "${TOOLS[@]}"; do
        # Skip tools that don't work on Windows
        for skip in "${SKIP_ON_WINDOWS[@]}"; do
            if [[ "$tool" == "$skip" ]]; then
                skipped+=("$tool")
                continue 2
            fi
        done

        local scoop_pkg="${SCOOP_NAME[$tool]:-$tool}"
        if scoop list "$scoop_pkg" 2>/dev/null | grep -q "$scoop_pkg"; then
            printf '  ✓ %s (already installed)\n' "$tool"
        else
            to_install+=("$scoop_pkg")
        fi
    done

    if [[ ${#skipped[@]} -gt 0 ]]; then
        warn "Skipped (not available on Windows): ${skipped[*]}"
    fi

    if [[ ${#to_install[@]} -eq 0 ]]; then
        info "All tools already installed!"
    else
        local failed=()
        for pkg in "${to_install[@]}"; do
            if ! scoop install "$pkg"; then
                failed+=("$pkg")
            fi
        done
        if [[ ${#failed[@]} -gt 0 ]]; then
            warn "Failed to install: ${failed[*]}"
        fi
    fi
}

# --- Homebrew ---

install_brew_local() {
    info "Installing Homebrew locally to ~/.linuxbrew (no root needed)"
    git clone https://github.com/Homebrew/brew ~/.linuxbrew/Homebrew
    mkdir -p ~/.linuxbrew/bin
    ln -sf ~/.linuxbrew/Homebrew/bin/brew ~/.linuxbrew/bin
    eval "$(~/.linuxbrew/bin/brew shellenv)"
}

install_brew_standard() {
    info "Installing Homebrew (standard install)"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Source it for this session
    if [[ -d /home/linuxbrew/.linuxbrew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
}

ensure_brew() {
    if command -v brew >/dev/null 2>&1; then
        info "Homebrew already installed: $(brew --prefix)"
        return
    fi

    if [[ "$(uname)" == "Darwin" ]]; then
        install_brew_standard
    elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        install_brew_standard
    else
        warn "No sudo access — installing Homebrew locally"
        install_brew_local
    fi
}

# --- Tools ---

install_tools() {
    info "Installing tools..."
    local to_install=()
    for tool in "${TOOLS[@]}"; do
        if brew list "$tool" &>/dev/null; then
            printf '  ✓ %s (already installed)\n' "$tool"
        else
            to_install+=("$tool")
        fi
    done

    if [[ ${#to_install[@]} -eq 0 ]]; then
        info "All tools already installed!"
    else
        info "Installing: ${to_install[*]}"
        brew install "${to_install[@]}"
    fi
}

# --- Zsh plugins (skip on git-bash) ---

install_zsh_plugins() {
    if ! command -v zsh >/dev/null 2>&1; then
        warn "Zsh not found — skipping zsh plugins"
        return
    fi
    info "Installing zsh plugins..."
    local to_install=()
    for plugin in "${ZSH_PLUGINS[@]}"; do
        if brew list "$plugin" &>/dev/null; then
            printf '  ✓ %s (already installed)\n' "$plugin"
        else
            to_install+=("$plugin")
        fi
    done
    if [[ ${#to_install[@]} -gt 0 ]]; then
        brew install "${to_install[@]}"
    fi
}

# --- jk (GitHub release binary) ---

install_jk() {
    if command -v jk >/dev/null 2>&1; then
        printf '  ✓ jk (already installed)\n'
        return
    fi

    info "Installing jk from GitHub..."
    local os arch
    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    arch="$(uname -m)"
    case "$arch" in
        x86_64)  arch="amd64" ;;
        aarch64|arm64) arch="arm64" ;;
        *) err "Unsupported architecture: $arch"; return 1 ;;
    esac

    local tarball="jk_${os}_${arch}.tar.gz"
    local url
    url="$(gh release view --repo redswoop/jk --json assets --jq ".assets[] | select(.name == \"$tarball\") | .url")"

    if [[ -z "$url" ]]; then
        err "No jk release found for ${os}/${arch}"
        return 1
    fi

    mkdir -p "$HOME/.local/bin"
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL "$url" -o "$tmp/$tarball"
    tar -xzf "$tmp/$tarball" -C "$tmp"
    mv "$tmp/jk" "$HOME/.local/bin/jk"
    chmod +x "$HOME/.local/bin/jk"
    rm -rf "$tmp"
    info "jk installed to ~/.local/bin/jk"
}

# --- Platform extras ---

platform_extras() {
    if [[ "$(uname)" == "Darwin" ]]; then
        if brew list --cask font-meslo-lg-nerd-font &>/dev/null; then
            printf '  ✓ Nerd Font (already installed)\n'
        else
            info "Installing Meslo Nerd Font..."
            brew install --cask font-meslo-lg-nerd-font
        fi
        warn "Remember to set 'MesloLGS Nerd Font' in your terminal app"
    fi
}

# --- Main ---

info "dotfiles-bootstrap"
echo

if is_gitbash; then
    info "Detected git-bash (Windows)"
    echo

    ensure_scoop
    echo

    install_tools_scoop
    echo

    warn "Zsh plugins skipped (not applicable on git-bash)"
else
    check_linux_prereqs
    echo

    ensure_brew
    echo

    install_tools
    echo

    install_zsh_plugins
    echo

    install_jk
    echo

    platform_extras
fi

echo
info "Done! Open a new shell to pick up changes."
