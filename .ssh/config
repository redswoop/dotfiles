# ~/.ssh/config — shared across machines via dotfiles (`dot`).
#
# Hostnames come from Tailscale MagicDNS: `stormer` -> stormer.tail93d23c.ts.net
# -> 100.x address. Tailscale goes direct over the LAN when both ends are home,
# so there's no need for separate -lan aliases or HostName lines.
#
# Machine-specific bits (colima, work hosts, etc.) go in ~/.ssh/config.local,
# which is untracked. It's included first so it can override anything below.
Include ~/.ssh/config.local

# Synology DSM: its default SSH port. Leave it — DSM updates reset changes.
Host hotbox
    Port 320
    HostKeyAlias hotbox

Host *
    User armen
    AddKeysToAgent yes
    ServerAliveInterval 30
    ServerAliveCountMax 4
