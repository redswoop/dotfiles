[user]
	name = Armen Nakashian
	email = anakashian@gmail.com
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[url "bbgithub:"]
	insteadof = https://bbgithub.dev.bloomberg.com/
[init]
	defaultBranch = main
