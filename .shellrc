# shellrc — shared config sourced by both .bashrc and .zshrc

# PATH
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Package manager PATH setup
if [ -n "${MSYSTEM:-}" ]; then
    # Scoop (git-bash on Windows) — convert Windows path to unix-style
    _scoop_shims="$(cygpath -u "$USERPROFILE/scoop/shims" 2>/dev/null || echo "$HOME/scoop/shims")"
    [ -d "$_scoop_shims" ] && export PATH="$_scoop_shims:$PATH"
    unset _scoop_shims
else
    # Homebrew (Linux/macOS)
    if [ -d /home/linuxbrew/.linuxbrew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -d "$HOME/.linuxbrew" ]; then
        eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
    fi
fi

# eza aliases (modern ls replacement)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
    alias l='eza -l'
    alias la='eza -la'
    alias ll='eza -la'
    alias lt='eza --tree'
else
    # Fallback: pick the right color flag for this ls implementation.
    # BSD ls (macOS) uses -G; GNU ls (Linux, git-bash) uses --color=auto.
    case "$(uname -s)" in
        Darwin)
            export CLICOLOR=1
            alias ls='ls -G'
            ;;
        MINGW*|MSYS*)
            alias ls='ls --color=auto --show-control-chars --hide=NTUSER* --hide=ntuser*'
            ;;
        *)
            alias ls='ls --color=auto'
            ;;
    esac
    alias l='ls -l'
    alias la='ls -la'
    alias ll='ls -la'
fi

# bat as pager/less replacement
if command -v bat >/dev/null 2>&1; then
    export BAT_THEME='Monokai Extended'
    export BAT_STYLE='numbers,changes,header,grid'
    export BAT_PAGER='less -RFi --mouse'
    export PAGER='bat'
    export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -l man -p'"
    alias cat='bat --paging=never'
    alias less='bat --paging=always'
else
    export LESS='-R -M -i -j5 --mouse'
fi

# jk (ps replacement)
if command -v jk >/dev/null 2>&1; then
    alias jk='jk -p -t'
fi

# Safe file operations (prompt before overwrite/delete)
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

alias du='du -h'

# fzf and zoxide shell integration
# For zsh, these are loaded in .zshrc (after compinit)
if [ -n "$BASH_VERSION" ]; then
    command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"
    command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
fi

# lazygit
if command -v lazygit >/dev/null 2>&1; then
    alias lg='lazygit'
fi

# dotfiles management (bare git repo)
alias dot='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'

# Toolkit cheatsheet — shown at login and on-demand via `cheat`
cheat() {
    cat <<'CHEAT'

  ⚡ TOOLKIT

  📂 ls l la lt ........... eza
  📄 cat less ............. bat
  📊 dust ................. du replacement
  🔍 rg ................... ripgrep (grep replacement)
  🔎 fd ................... find replacement
  ⚙️  jk ................... ps + ports + tree
  📈 btop / htop .......... top replacements
  🌳 lg ................... lazygit
  💾 dot .................. dotfiles git
  📖 tldr ................. cheatsheets
  🔀 git diff ............. delta (side-by-side)
  📋 jq / yq .............. JSON / YAML

  🚀 SHORTCUTS

  z <dir>     smart cd      Ctrl+R   fuzzy history
  Ctrl+T      fuzzy files   \rm      bypass alias
  →           accept ghost suggestion (autosuggestions)

CHEAT
}

# Show cheatsheet as MOTD on interactive shells
[[ $- == *i* ]] && cheat

# Starship prompt (cross-shell)
if command -v starship >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(starship init zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(starship init bash)"
    fi
fi
