# shellrc — shared config sourced by both .bashrc and .zshrc

# PATH
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# rust (rustup) — only where installed
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Package manager PATH setup
if [ -n "${MSYSTEM:-}" ]; then
    # Scoop (git-bash on Windows) — convert Windows path to unix-style
    _scoop_shims="$(cygpath -u "$USERPROFILE/scoop/shims" 2>/dev/null || echo "$HOME/scoop/shims")"
    [ -d "$_scoop_shims" ] && export PATH="$_scoop_shims:$PATH"
    unset _scoop_shims
else
    # Homebrew (Linux/macOS)
    if [ -d /home/linuxbrew/.linuxbrew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -d "$HOME/.linuxbrew" ]; then
        eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
    fi

    # Brew: silence env hints, throttle metadata auto-update to once a week
    export HOMEBREW_NO_ENV_HINTS=1
    export HOMEBREW_AUTO_UPDATE_SECS=604800
fi

# Brew outdated tracker — background-refreshed once/day, persistent nag until upgraded.
# Decouples "am I dirty?" (cheap file read) from "go check" (slow network call).
if command -v brew >/dev/null 2>&1; then
    _brew_outdated_list="$HOME/.cache/brew-outdated.list"
    _brew_outdated_stamp="$HOME/.cache/brew-outdated.stamp"

    _brew_outdated_check() {
        mkdir -p "$HOME/.cache"

        # Show cached list if non-empty — cheap, runs every shell start
        if [ -s "$_brew_outdated_list" ]; then
            local count
            count=$(wc -l < "$_brew_outdated_list" | tr -d ' ')
            printf '\033[1;33m  📦 %s brew package(s) outdated\033[0m — run \033[1mbrew upgrade\033[0m\n\n' "$count"
        fi

        # Refresh in background if stamp missing or >24h old (find -mtime +0 is portable)
        if [ ! -f "$_brew_outdated_stamp" ] || [ -n "$(find "$_brew_outdated_stamp" -mtime +0 2>/dev/null)" ]; then
            touch "$_brew_outdated_stamp"
            { command brew outdated --quiet > "$_brew_outdated_list.tmp" 2>/dev/null \
                && mv "$_brew_outdated_list.tmp" "$_brew_outdated_list"; } >/dev/null 2>&1 &
            disown 2>/dev/null || true
        fi
    }

    # Clear cache after a successful `brew upgrade` so the nag vanishes immediately
    brew() {
        command brew "$@"
        local rc=$?
        if [ "${1:-}" = "upgrade" ] && [ $rc -eq 0 ]; then
            rm -f "$_brew_outdated_list" "$_brew_outdated_stamp"
        fi
        return $rc
    }
fi

# eza aliases (modern ls replacement)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
    alias l='eza -l'
    alias la='eza -la'
    alias ll='eza -la'
    alias lt='eza --tree'
else
    # Fallback: pick the right color flag for this ls implementation.
    # BSD ls (macOS) uses -G; GNU ls (Linux, git-bash) uses --color=auto.
    case "$(uname -s)" in
        Darwin)
            export CLICOLOR=1
            alias ls='ls -G'
            ;;
        MINGW*|MSYS*)
            alias ls='ls --color=auto --show-control-chars --hide=NTUSER* --hide=ntuser*'
            ;;
        *)
            alias ls='ls --color=auto'
            ;;
    esac
    alias l='ls -l'
    alias la='ls -la'
    alias ll='ls -la'
fi

# bat as pager/less replacement
if command -v bat >/dev/null 2>&1; then
    export BAT_THEME='Monokai Extended'
    export BAT_STYLE='numbers,changes,header,grid'
    export BAT_PAGER='less -RFi --mouse'
    export PAGER='bat'
    export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" | bat -l man -p'"
    alias cat='bat --paging=never'
    alias less='bat --paging=always'
else
    export LESS='-R -M -i -j5 --mouse'
fi

# jk (ps replacement)
if command -v jk >/dev/null 2>&1; then
    alias jk='jk -p -t'
fi

# Safe file operations (prompt before overwrite/delete)
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

alias du='du -h'

# fzf and zoxide shell integration
# For zsh, these are loaded in .zshrc (after compinit)
#
# zoxide's "doctor" warns unless its prompt hook is the LAST one registered.
# We can't satisfy that here: starship, iTerm2 integration, and .lcldevrc all
# register prompt hooks after this file returns (and .shellrc is sourced
# mid-file in both .bashrc and .zshrc). zoxide itself works fine regardless —
# the check is a heuristic that false-positives on multi-hook setups. Disable
# it cross-shell rather than chase per-platform ordering. https://github.com/ajeetdsouza/zoxide#configuration
export _ZO_DOCTOR=0
if [ -n "$BASH_VERSION" ]; then
    command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"
    command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
fi

# lazygit
if command -v lazygit >/dev/null 2>&1; then
    alias lg='lazygit'
fi

# findmnt — real filesystems only, useful columns (skips cgroup/proc/snap-loop noise)
if command -v findmnt >/dev/null 2>&1; then
    alias mnt='findmnt --real -t nosquashfs -o TARGET,SOURCE,FSTYPE,SIZE,USE%,OPTIONS'
fi

# dotfiles management (bare git repo)
alias dot='git --git-dir=$HOME/.dotfiles --work-tree=$HOME'

# Toolkit cheatsheet — shown at login and on-demand via `cheat`
cheat() {
    cat <<'CHEAT'

  ⚡ TOOLKIT

  📂 ls l la lt ........... eza
  📄 cat less ............. bat
  📊 dust ................. du replacement
  🔍 rg ................... ripgrep (grep replacement)
  🔎 fd ................... find replacement
  ⚙️  jk ................... ps + ports + tree
  🗂️  mnt .................. findmnt (real mounts)
  📈 btop / htop .......... top replacements
  🌳 lg ................... lazygit
  💾 dot .................. dotfiles git
  📖 tldr ................. cheatsheets
  🔀 git diff ............. delta (side-by-side)
  📋 jq / yq .............. JSON / YAML

  🚀 SHORTCUTS

  z <dir>     smart cd      Ctrl+R   fuzzy history
  Ctrl+T      fuzzy files   \rm      bypass alias
  →           accept ghost suggestion (autosuggestions)

CHEAT
}

# Show cheatsheet as MOTD on interactive shells
if [[ $- == *i* ]]; then
    cheat
    command -v _brew_outdated_check >/dev/null 2>&1 && _brew_outdated_check
fi

# Starship prompt (cross-shell)
if command -v starship >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(starship init zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(starship init bash)"
    fi
fi

# Machine-local overrides — NOT tracked. Where this box keeps its software,
# hardware-specific aliases, work hooks. Installers that want to append to
# .zshrc/.bashrc should be redirected here instead. Sourced last so it wins.
[ -f "$HOME/.shellrc.local" ] && . "$HOME/.shellrc.local"
